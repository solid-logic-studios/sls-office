{
  "name": "sls-office",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "SLS Office: the lab as an animated, themed pixel-art dashboard (engine, themes, simulator)",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema": "node scripts/generate-schema.ts",
    "voice-lines": "node scripts/voice-lines.ts",
    "build": "vite build && pnpm schema",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.10.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
